# Copy this file to .env before running docker compose.

# Required secrets
SECRET_KEY=liuying
NEO4J_PASSWORD=liuying

# Public origin. Use http://your-server-ip for first test, then https://your-domain after HTTPS.
CORS_ORIGINS=http://39.96.44.110
WEB_PORT=80

# Cookie settings. Use true after HTTPS is enabled.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=Lax
AUTH_COOKIE_NAME=kg_auth
TOKEN_TTL_SECONDS=43200

# Optional LLM config
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_MAX_TOKENS=1024
