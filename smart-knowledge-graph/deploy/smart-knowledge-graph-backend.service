[Unit]
Description=Smart Knowledge Graph Flask API
After=network.target neo4j.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/smart-knowledge-graph/backend
EnvironmentFile=-/etc/smart-knowledge-graph/backend.env
ExecStart=/opt/smart-knowledge-graph/backend/.venv/bin/gunicorn --bind 127.0.0.1:5000 --workers 3 --timeout 120 "app:create_app()"
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
