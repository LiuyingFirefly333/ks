# Copy this file to backend/.env on a non-Docker server.

# App
APP_ENV=production
SECRET_KEY=replace-with-a-long-random-secret
TOKEN_TTL_SECONDS=43200
AUTH_COOKIE_NAME=kg_auth
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=Lax

# Neo4j installed directly on the host
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-your-neo4j-password

# Flask/Gunicorn listens on localhost; Nginx exposes the site publicly.
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false
CORS_ORIGINS=http://your-server-ip

# DeepSeek LLM
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_MAX_TOKENS=1024
